// ============================================================================
// memory.sn - Memory Management Features in Sindarin
// ============================================================================
// Demonstrates: automatic arena management, ordinary loops,
// copyOf (copy semantics), as ref (reference semantics)
// ============================================================================

// --- Function ---
fn add_numbers(a: int, b: int): int =>
  return a + b

// --- Function ---
fn compute_sum(): int =>
  var sum: int = 0
  for var i: int = 1; i <= 10; i++ =>
    sum = sum + i
  return sum

// Entry point for memory demos
fn demo_memory(): void =>
  print("\n┌──────────────────────────────────────────────────────────────────┐\n")
  print("│                   Sindarin Memory Management                     │\n")
  print("└──────────────────────────────────────────────────────────────────┘\n\n")

  // 1. Functions
  print("--- Functions ---\n")
  print("Functions for helper computations\n")
  var result: int = add_numbers(10, 20)
  print($"add_numbers(10, 20) = {result}\n")

  // 2. Functions
  print("\n--- Functions ---\n")
  print("Functions for temporary work\n")
  var sum: int = compute_sum()
  print($"compute_sum() = {sum}\n")

  // 3. Automatic Arena Management
  print("\n--- Automatic Arena Management ---\n")
  print("The compiler infers arena ownership for local values\n")
  var x: int = 10
  var y: int = 20
  x = x + y
  print($"After local computation: x = {x}\n")

  // 4. Local Values
  print("\n--- Local Values ---\n")
  print("Temporary values are released according to inferred ownership\n")
  var computed: int = 0
  var a: int = 100
  var b: int = 200
  computed = a + b
  print($"Computed value: {computed}\n")

  // 5. Loops
  print("\n--- Loops ---\n")
  print("Loop memory strategy is inferred automatically\n")
  var total: int = 0
  for var i: int = 0; i < 5; i++ =>
    total = total + i
  print($"Sum from for loop: {total}\n")

  var count: int = 0
  while count < 3 =>
    count = count + 1
  print($"Count from while loop: {count}\n")

  var arr: int[] = {1, 2, 3, 4, 5}
  var arrSum: int = 0
  for n in arr =>
    arrSum = arrSum + n
  print($"Sum from for-each: {arrSum}\n")

  // 6. Explicit Copy Semantics
  print("\n--- Explicit Copy Semantics ---\n")
  print("copyOf() creates an independent array copy\n")
  var original: int[] = {10, 20, 30}
  var copy: int[] = copyOf(original)
  original.push(40)
  print("Original after push(40): ")
  print(original)
  print("\n")
  print("Copy (unchanged): ")
  print(copy)
  print("\n")

  // 7. as ref (Reference Semantics for Primitives)
  print("\n--- as ref (Reference Semantics) ---\n")
  print("'as ref' allocates primitives on heap (for escaping scopes)\n")
  var value: int as ref = 42
  print($"value (as ref) = {value}\n")
  value = 100
  print($"modified value = {value}\n")
