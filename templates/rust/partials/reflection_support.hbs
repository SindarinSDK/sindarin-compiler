#[allow(non_snake_case)]
#[derive(Clone, Debug, PartialEq)]
struct FieldInfo {
    name: SnString,
    typeName: SnString,
    typeId: i64,
}

#[allow(non_snake_case)]
#[derive(Clone, Debug, PartialEq)]
struct TypeInfo {
    name: SnString,
    fields: Vec<FieldInfo>,
    fieldCount: i64,
    typeId: i64,
}
