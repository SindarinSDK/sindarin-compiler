#[allow(non_snake_case)]
#[derive(Clone, Debug, PartialEq)]
struct FieldInfo {
    name: String,
    typeName: String,
    typeId: i64,
}

#[allow(non_snake_case)]
#[derive(Clone, Debug, PartialEq)]
struct TypeInfo {
    name: String,
    fields: Vec<FieldInfo>,
    fieldCount: i64,
    typeId: i64,
}