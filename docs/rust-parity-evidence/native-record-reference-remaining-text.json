  "passed": false,
  "source_text": "struct Record =>\n  mark: char\n  count: int\n\n  fn bump(): char =>\n    var before: char = self.mark\n    self.mark++\n    self.count = self.count + 1\n    return before\n\nnative fn observe(value: Record as ref): int =>\n  return value.count\n\nfn main(): void =>\n  var value: Record = {\n    mark: 'a',\n    count: 4\n  }\n  println(observe(value))\n  println(value.bump())\n  println($\"{value.mark} {value.count}\")\n  value.mark--\n  println(value.mark)\n  value.mark += 2\n  println(value.mark)\n  var values: Record[] = {}\n  values.push(value)\n  values[0].mark++\n  println(values[0].mark)\n    println(values.join(\",\"))\n"
}
