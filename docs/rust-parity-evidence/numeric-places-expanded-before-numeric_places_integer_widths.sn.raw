fn main(): void =>
  var values: int[] = {10, 21, 16, 8, 17}
  println(values[0] += 5)
  println(values[1] -= 4)
  println(values[2] *= 3)
  println(values[3] /= 2)
  println(values[4] %= 5)
  println(values[0]++)
  println(values[0]--)
  println(values[0])
  var bytes: byte[] = {250b}
  println(bytes[0] += 10b)
  println(bytes[0] *= 100b)
  println(bytes[0] /= 3b)
  println(bytes[0] %= 5b)
  println(bytes[0] <<= 1b)
  println(bytes[0] >>= 1b)
  println(bytes[0] ^= 4b)
  println(bytes[0] &= 3b)
  println(bytes[0] |= 8b)
  var narrow: int32[] = {20i32}
  var wideRhs: int = 3
  println(narrow[0] -= wideRhs)
  var unsigned: uint32[] = {4294967295u32}
  println(unsigned[0] += 1u32)
  println(unsigned[0]++)
  println(unsigned[0]--)
  println(unsigned[0])
  var wideUnsigned: uint[] = {18446744073709551615u}
  var one: uint = 1u
  println(wideUnsigned[0] += one)
  println(wideUnsigned[0]--)
  println(wideUnsigned[0])
  var longs: long[] = {30l}
  println(longs[0] /= 3l)
