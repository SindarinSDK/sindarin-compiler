struct FloatingBag =>
  values: float[] = {}

fn appendAndCopy(values: float[], calls: int as ref): float[] =>
  calls++
  values.push(0.0f)
  return values

fn main(): void =>
  var calls: int = 0
  var values: float[] = {0.0f}
  println(values == appendAndCopy(values, calls))
  println(values.length)
  println(calls)
  println(appendAndCopy(values, calls) == values)
  println(values.length)
  println(calls)
  println(values != appendAndCopy(values, calls))
  println(values.length)
  println(calls)
  var bag: FloatingBag = {values: {0.0f}}
  println(bag.values == appendAndCopy(bag.values, calls))
  println(bag.values.length)
  println(calls)
