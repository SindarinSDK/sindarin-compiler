  "repairs": [
    "Admit explicit as-ref and mutating-receiver as-val plain heap-free record method parameters",
    "Bind record-reference reads and whole-record assignment results to actual parameter representations",
    "Resolve indexed record argument bounds at the original argument position before a mutable borrow",
