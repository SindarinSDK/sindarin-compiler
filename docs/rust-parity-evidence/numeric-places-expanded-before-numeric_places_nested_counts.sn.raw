struct Inner =>
  value: int

struct Outer =>
  inner: Inner

fn index(calls: int as ref, result: int): int =>
  calls++
  return result

fn main(): void =>
  var calls: int = 0
  var rows: int[][] = {{10, 20}, {30, 40}}
  println(rows[index(calls, 1)][index(calls, 0)] += 5)
  println(calls)
  println(rows[1][0])
  calls = 0
  println(rows[index(calls, 1)][index(calls, -1)] -= 3)
  println(calls)
  println(rows[1][1])
  calls = 0
  println(rows[index(calls, -1)][index(calls, -1)]++)
  println(calls)
  println(rows[1][1])
  var outers: Outer[] = {Outer {inner: Inner {value: 7}}}
  calls = 0
  println(outers[index(calls, 0)].inner.value += 2)
  println(calls)
  println(outers[0].inner.value--)
  println(outers[0].inner.value)
