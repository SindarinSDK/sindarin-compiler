struct Point =>
  x: int

fn observe_text(counter: int as ref): str =>
  counter += 1
  return "called"

fn observe_values(counter: int as ref): int[] =>
  counter += 1
  return {1, 2}

fn main(): void =>
  var type_string: int = sizeof(str)
  var type_array: int = sizeof int[]
  var type_nested_array: int = sizeof(int[][])
  var type_struct_array: int = sizeof(Point[])

  var text: str = "managed"
  var values: int[] = {1, 2}
  var rows: int[][] = {{1, 2}}
  var points: Point[] = { Point { x: 1 } }
  var counter: int = 0
  var expression_sizes: int = sizeof(text) + sizeof values + sizeof(rows) + sizeof(points) + sizeof observe_text(counter) + sizeof(observe_values(counter))
