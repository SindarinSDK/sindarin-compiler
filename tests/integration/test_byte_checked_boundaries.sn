fn main(): void =>
  var max: byte = 255b
  var one: byte = 1b
  var add_base: byte = 254b
  var sum: byte = add_base + one
  var difference: byte = one - one
  var product: byte = max * one
  var quotient: byte = max / one
  var remainder: byte = max % one
  var wide_left: byte = 200b
  var wide_right: byte = 200b
  var wide_sum: int = wide_left.toInt() + wide_right.toInt()
  print($"{sum} {difference} {product} {quotient} {remainder} {wide_sum}\n")
