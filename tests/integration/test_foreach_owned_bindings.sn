# Array foreach binds an independently owned value.  This exercises normal
# flow, break, continue, and return; each source collection must still own
# and expose its original heap-bearing elements after the loop local changes.

struct Record =>
  label: str
  values: int[]

struct RefRecord as ref =>
  label: str

fn assignNormal(names: str[]): void =>
  for name in names =>
    name = name + "!"

fn assignThenBreak(names: str[]): void =>
  for name in names =>
    name = "break-local"
    break

fn assignThenContinue(names: str[]): void =>
  for name in names =>
    name = "continue-local"
    continue

fn assignThenReturn(names: str[]): str =>
  for name in names =>
    name = "return-local"
    return name
  return "missing"

fn main(): int =>
  var names: str[] = {"alpha", "beta"}
  assignNormal(names)
  assignThenBreak(names)
  assignThenContinue(names)
  var returned: str = assignThenReturn(names)
  assert(returned == "return-local", $"unexpected return '{returned}'")
  assert(names[0] == "alpha", $"names[0] changed or freed: '{names[0]}'")
  assert(names[1] == "beta", $"names[1] changed or freed: '{names[1]}'")

  var rows: int[][] = {{1, 2}, {3, 4}}
  for row in rows =>
    row = {99}
  assert(rows[0][0] == 1 && rows[1][1] == 4, "nested arrays lost source ownership")

  var first: Record = {
    label: "first",
    values: {10}
  }
  var second: Record = {
    label: "second",
    values: {20}
  }
  var records: Record[] = {first, second}
  for record in records =>
    record = Record {
      label: "local",
      values: {99}
    }
  assert(records[0].label == "first", "value struct string field was freed")
  assert(records[0].values[0] == 10, "value struct array field was freed")
  assert(records[1].label == "second", "second value struct changed")

  var left: RefRecord = { label: "left" }
  var right: RefRecord = { label: "right" }
  var refs: RefRecord[] = {left, right}
  for refRecord in refs =>
    refRecord = RefRecord { label: "local" }
  assert(refs[0].label == "left", "reference struct array element was released")
  assert(refs[1].label == "right", "second reference struct changed")

  print("PASS\n")
  return 0
