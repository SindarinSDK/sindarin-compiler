struct Item =>
  value: int

  operator < (other: Item as ref): bool =>
    other.value = other.value + 1
    return self.value < other.value

fn makeFrom(item: Item): Item =>
  return Item { value: item.value + 1 }

fn main(): void =>
  var item: Item = { value: 1 }
  println(item > makeFrom(item))
  println(item.value)
