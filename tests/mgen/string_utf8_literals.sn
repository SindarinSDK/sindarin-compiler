fn main(): int =>
  var greedy: str = "X\x1FAb09Y"
  var boundaries: str = "\xC2\x80\xDF\xBF\xE0\xA0\x80\xED\x9F\xBF\xEE\x80\x80\xEF\xBF\xBF\xF0\x90\x80\x80\xF4\x8F\xBF\xBF"
  var controls: str = "\n\t\r\"\\"
  var unicode: str = "é世界🙂"
  return match greedy =>
    "X\x1FAb09Y" => 0
    else => boundaries.length + controls.length + unicode.length
