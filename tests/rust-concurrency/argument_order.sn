var sequence: int = 0
fn next(): int =>
  sequence = sequence + 1
  return sequence
fn combine(a: int, b: int): int =>
  return a * 10 + b
fn main(): void =>
  var result: int = & combine(next(), next())
  println($"before join: {sequence}")
  result !
  println($"result: {result}")
  result !
  println($"repeat join: {result}")
