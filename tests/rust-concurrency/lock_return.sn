sync var gate: int = 0
var counter: int = 0
fn update(early: bool): void =>
  lock (gate) =>
    counter = counter + 1
    if early =>
      return
    counter = counter + 1
fn main(): void =>
  update(true)
  lock (gate) =>
    counter = counter + 100
  update(false)
  println($"counter: {counter}")
  println($"twice: {counter + counter}")
