import "sindarin-pkg-sdk/src/io/stdio"

fn main(): void =>
  println(Stdin.hasChars())
  println(Stdin.hasLines())
  println(Stdin.isEof())
  var line: str = Stdin.readLine()
  println(line)
  println(Stdin.readChar())
  println(Stdin.readWord())
  println(Stdin.readWord())
  println(Stdin.isEof())
  println(Stdin.hasChars())
  println(Stdin.hasLines())
  println(Stdin.readChar())
  println(Stdin.readWord() == nil)
  println(Stdin.readWord().length)
  println(Stdin.readLine() == nil)
  println(Stdin.readLine().length)
  println(line)
  Stdout.write(nil)
  Stdout.writeLine(nil)
  Stdout.flush()
  Stderr.write(nil)
  Stderr.writeLine(nil)
  Stderr.writeLine(line)
  Stderr.flush()
