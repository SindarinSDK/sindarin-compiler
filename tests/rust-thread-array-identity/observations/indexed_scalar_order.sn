struct Item =>
  value: int = 0
fn append(items: Item[]): int =>
  items.push(Item { value: 2 })
  return 1
fn rhs(items: Item[]): int =>
  var worker: int = & append(items)
  worker !
  println("rhs")
  return 7
fn index(items: Item[]): int =>
  println("index")
  return - 1
fn update(items: Item[]): int =>
  items[index(items)].value = rhs(items)
  return items[1].value
fn main(): void =>
  var items: Item[] = { Item { value: 1 } }
  var result: int = & update(items)
  println(result !)
  println(items[1].value)
  println(items.length)
