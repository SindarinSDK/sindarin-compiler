struct Item =>
  value: int

  fn read(): int =>
    return self.value

fn main(): void =>
  var values: Item[] = { Item { value: 7 }, Item { value: 30 } }
  println(values[0].read() == 7)
  var sum: int = 0
  for item in values =>
    sum += item.value
    values.reverse()
  println(sum == 14)
  println(values[0].value == 7 && values[1].value == 30)
