native fn invoke(action: fn(int[][]): int[][], values: int[][]): int[][] =>
  return action(values)

fn main(): void =>
  var values: int[][] = {{7}}
  var action: fn(int[][]): int[][] = fn(input: int[][]): int[][] =>
    input[0].push(8)
    return input
  var copied: int[][] = invoke(action, values)
  println(values[0].length == 2 && values[0][1] == 8)
  copied[0].clear()
  println(values[0].length == 2 && copied[0].length == 0)
