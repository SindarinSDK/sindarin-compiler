struct Ops =>
  marker: int

  fn update(a: int[], b: int[], c: int[], d: int[]): int =>
    a[0] += self.marker
    b[0] += 2
    c[0] += 4
    d[0] += 8
    return a[0]

  static fn staticUpdate(a: int[], b: int[], c: int[], d: int[]): int =>
    a[0] += 1
    b[0] += 2
    c[0] += 4
    d[0] += 8
    return a[0]

fn main(): void =>
  var instance: fn(int[], int[], int[]): int = fn(a: int[], b: int[], c: int[]): int =>
    var ops: Ops = { marker: 1 }
    return ops.update(a, a, b, c)
  var staticCall: fn(int[], int[], int[]): int = fn(a: int[], b: int[], c: int[]): int =>
    return Ops.staticUpdate(a, a, b, c)
  var same: int[] = {1}
  println(instance(same, same, same) == 16)
  println(same[0] == 16)
  var second: int[] = {1}
  println(staticCall(second, second, second) == 16)
  println(second[0] == 16)
  var a: int[] = {10}
  var b: int[] = {20}
  var c: int[] = {30}
  println(instance(a, b, c) == 13)
  println(a[0] == 13 && b[0] == 24 && c[0] == 38)
  println(staticCall(a, b, c) == 16)
  println(a[0] == 16 && b[0] == 28 && c[0] == 46)
