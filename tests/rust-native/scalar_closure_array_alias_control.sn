struct Bag =>
  values: int[]

fn named(values: int[]): int =>
  values[0] += 10
  return values[0]

fn main(): void =>
  var values: int[] = {1, 2}
  var mutate: fn(int[]): int = fn(a: int[]): int =>
    a[0] += 1
    a.push(5)
    return a.length
  println(mutate(values) == 3 && values[0] == 2 && values[2] == 5)
  var aliases: fn(int[], int[]): int = fn(a: int[], b: int[]): int =>
    a.push(9)
    var observed = b.length
    b[0] += 1
    return observed
  println(aliases(values, values) == 4 && values[0] == 3 && values[3] == 9)
  var distinct: int[] = {7}
  println(aliases(values, distinct) == 1 && values.length == 5 && distinct[0] == 8)
