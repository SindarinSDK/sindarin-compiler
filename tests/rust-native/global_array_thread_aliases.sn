var numbers: int[] = {1, 2}
var total: int = 1

fn grow(left: int[], right: int[]): int =>
  left.push(3)
  right[0] = 8
  return len(left)

fn shadow(): void =>
  var numbers: int[] = {9}
  var count: int = & grow(numbers, numbers)
  count !
  println($"shadow {count} {numbers[0]} {numbers[1]}")

fn add(left: int as ref, right: int as ref): int =>
  left += 1
  right += 2
  return left

fn main(): void =>
  var count: int = & grow(numbers, numbers)
  count !
  println($"first {count} {numbers[0]} {numbers[2]}")
  shadow()
  println($"global {len(numbers)} {numbers[0]}")
  numbers = {4, 5}
  count = & grow(numbers, numbers)
  count !
  println($"replaced {count} {numbers[0]} {numbers[2]}")

  var added: int = & add(total, total)
  added !
  println($"scalar {added} {total}")
  total = 10
  added = & add(total, total)
  added !
  println($"scalar_again {added} {total}")
