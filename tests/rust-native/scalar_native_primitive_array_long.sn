@source "scalar_native_primitive_array_long.sn.c"
native fn change_array(a: long[]): void
native fn same_array(a: long[], b: long[]): bool
fn main(): void =>
  var original: long[] = {1l}
  println(same_array(original, original))
  change_array(original)
  println(original.length == 2 && original[0] == 7l && original[1] == 9l)
