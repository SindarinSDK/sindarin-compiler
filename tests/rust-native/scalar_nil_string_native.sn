@source "nil-next-native-string.sn.c"

native fn absent(): str
native fn empty(): str
native fn is_absent(value: str): bool

fn main(): void =>
  var value: str = absent()
  println(value == nil)
  println(is_absent(value))
  value = empty()
  println(value == nil)
  println(is_absent(value))
  println(value.length)
  value = nil
  println(is_absent(value))
