struct Item =>
  value: int
  label: str
  values: int[]

fn main(): void =>
  var original: Item = {
    value: 1,
    label: "old",
    values: {2}
  }
  var change = fn(a: Item as val): Item =>
    a.value = 9
    a.values.push(3)
    return a
  var result: Item = change(original)
  println(result.value == 9 && result.values.length == 2 && result.label == "old")
  result.values.push(4)
  println(original.value == 1 && original.values.length == 1)
