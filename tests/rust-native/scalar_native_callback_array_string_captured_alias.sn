@source "native_callback_array_string_native_alias.sn.c"

native fn same(values: str[], value: str): bool
native fn invoke(action: fn(): bool): bool =>
  return action()

fn main(): void =>
  var values: str[] = {"a"}
  var action: fn(): bool = fn(): bool => same(values, values[0])
  println(invoke(action))
  println(values[0] == "a")
