@source "native_callback_array_char_foreign.sn.c"

native fn make(): fn(char[]): char[]

fn main(): void =>
  var action: fn(char[]): char[] = make()
  var values: char[] = {'a'}
  var result: char[] = action(values)
  println(values.length == 2 && values[1] == 'b')
  result.clear()
  println(values.length == 2 && result.length == 0)
