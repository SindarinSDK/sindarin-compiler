struct Item =>
  value: int
  label: str
  values: int[]

fn main(): void =>
  var original: Item[] = { Item {
    value: 1,
    label: "old",
    values: {2}
  } }
  var change = fn(a: Item[] as val): Item[] =>
    a = { Item {
      value: 3,
      label: "new",
      values: {4}
    } }
    a[0].value = 9
    return a
  var result: Item[] = change(original)
  println(result[0].value == 9 && result[0].label == "new")
  println(original[0].value == 1 && original[0].label == "old")
