struct Item =>
  value: int
  label: str
  values: int[]

struct Holder =>
  item: Item

fn make(): Item =>
  return Item {
    value: 1,
    label: "old",
    values: {2}
  }

fn main(): void =>
  var original: Item = {
    value: 1,
    label: "old",
    values: {2}
  }
  var items: Item[] = {original}
  var holder: Holder = { item: Item {
    value: 1,
    label: "old",
    values: {2}
  } }
  var change = fn(a: Item as val): int =>
    a.value = 9
    a.values.push(3)
    return a.value + a.values.length
  println(change(items[0]) == 11)
  println(items[0].value == 1 && items[0].values.length == 1)
  println(change(holder.item) == 11)
  println(holder.item.value == 1 && holder.item.values.length == 1)
  println(change(make()) == 11)
