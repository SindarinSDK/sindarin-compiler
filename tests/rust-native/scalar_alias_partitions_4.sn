fn update(a: int[], b: int[], c: int[], d: int[], depth: int): int =>
  if depth > 0 =>
    return update(a, b, c, d, depth - 1)
  a[0] += 1
  a.push(100)
  b[0] += 2
  b.push(101)
  c[0] += 4
  c.push(102)
  d[0] += 8
  d.push(103)
  return a.length

fn main(): void =>
  var forward: fn(int[], int[], int[], int[]): int = fn(a: int[], b: int[], c: int[], d: int[]): int =>
    return update(a, b, c, d, 2)
  var v0_0: int[] = {10}
  var result0: int = forward(v0_0, v0_0, v0_0, v0_0)
  println(result0 == 5 && v0_0[0] == 25 && v0_0.length == 5 && v0_0[1] == 100 && v0_0[2] == 101 && v0_0[3] == 102 && v0_0[4] == 103)
