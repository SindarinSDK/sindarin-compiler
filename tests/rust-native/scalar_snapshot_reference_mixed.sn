fn update(a: int as ref, b: int as ref): int =>
  a += 2
  b *= 3
  return a
fn main(): void =>
  var snapshot: int = 1
  var actual: int = 2
  var change = fn(a: int as ref): int =>
    return update(snapshot, a)
  println(change(actual) == 3 && actual == 6)
  println(change(actual) == 3 && actual == 18)
  println(snapshot == 1)
