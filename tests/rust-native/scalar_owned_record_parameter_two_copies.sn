struct Item =>
  value: int
  label: str
  values: int[]

fn main(): void =>
  var original: Item = {
    value: 1,
    label: "old",
    values: {2}
  }
  var change = fn(a: Item as val, b: Item as val): int =>
    a.value = 9
    a.values.push(3)
    return b.value * 100 + b.values.length * 10 + a.values.length
  println(change(original, original) == 112)
  println(original.value == 1 && original.values.length == 1)
