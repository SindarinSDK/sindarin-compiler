struct State =>
  value: int
  other: int

fn main(): void =>
  var state: State = {
    value: 1,
    other: 2
  }
  var change = fn(a: int as ref, b: int as ref): int =>
    a += 2
    b *= 3
    return a
  println(change(state.value, state.value) == 9)
  println(state.value == 9)
  println(change(state.value, state.other) == 11)
  println(state.value == 11 && state.other == 6)
