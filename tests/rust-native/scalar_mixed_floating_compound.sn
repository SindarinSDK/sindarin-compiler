var globalFloating: float = 1.5f
var globalInteger: int = 1

fn addFloating(value: double): double =>
  return value += 2

fn addInteger(value: int): int =>
  return value += 2.75

fn updateReference(value: int as ref): int =>
  return value *= 1.5

fn fraction(calls: int as ref): double =>
  calls++
  return 2.75

struct Numbers =>
  floating: float
  integer: int

fn main(): void =>
  var floating: float = 1.5f
  var result1: float = floating += 2
  println(result1 == 3.5f)
  var result2: float = floating -= 1i32
  println(result2 == 2.5f)
  var result3: float = floating *= 2u32
  println(result3 == 5.0f)
  var result4: float = floating /= 2l
  println(result4 == 2.5f)
  var integer: int = -5
  var result5: int = integer += 2.75
  println(result5 == -2)
  var result6: int = integer -= 1.75f
  println(result6 == -3)
  var result7: int = integer *= 1.5
  println(result7 == -4)
  var result8: int = integer /= 1.5f
  println(result8 == -2)
  var narrow: int32 = 5i32
  var unsigned: uint32 = 5u32
  var wider: uint = 5u
  var small: byte = 5b
  var result9: int32 = narrow *= 1.5
  println(result9 == 7i32)
  var result10: uint32 = unsigned += 2.75f
  println(result10 == 7u32)
  var result11: uint = wider /= 2.0
  println(result11 == 2u)
  var result12: byte = small -= 2.75
  println(result12 == 2b)
  var rounded: float = 16777216.0f
  rounded += 1
  println(rounded == 16777216.0f)
  rounded += 1.00000001
  println(rounded == 16777218.0f)
  var caller: int = 1
  println(addInteger(caller) == 3 && caller == 1)
  println(addFloating(1.5) == 3.5)
  println(updateReference(caller) == 1 && caller == 1)
  var calls: int = 0
  var result13: int = caller += fraction(calls)
  println(result13 == 3 && calls == 1)
  var fields: Numbers = {
    floating: 1.5f,
    integer: 1
  }
  var result14: float = fields.floating += 2
  println(result14 == 3.5f)
  var result15: int = fields.integer += 2.75
  println(result15 == 3)
  var values: int[] = {1}
  var result16: int = values[0] += 2.75
  println(result16 == 3)
  var floatingSnapshot = fn(value: float as val): float =>
    return value += 2
  var integerSnapshot = fn(value: int as val): int =>
    return value += 2.75
  println(floatingSnapshot(1.5f) == 3.5f)
  println(integerSnapshot(1) == 3)
  var capturedFloat: float = 1.5f
  var capturedInteger: int = 1
  var sharedFloating = fn(): float =>
    return capturedFloat += 2
  var sharedInteger = fn(): int =>
    return capturedInteger += 2.75
  println(sharedFloating() == 3.5f)
  println(sharedInteger() == 3)
  var globalResultFloat: float = globalFloating += 2
  var globalResultInteger: int = globalInteger += 2.75
  println(globalResultFloat == 3.5f)
  println(globalResultInteger == 3)
