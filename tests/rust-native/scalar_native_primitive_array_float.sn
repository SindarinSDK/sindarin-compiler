@source "scalar_native_primitive_array_float.sn.c"
native fn change_array(a: float[]): void
native fn same_array(a: float[], b: float[]): bool
fn main(): void =>
  var original: float[] = {1.0f}
  println(same_array(original, original))
  change_array(original)
  println(original.length == 2 && original[0] == 7.0f && original[1] == 9.0f)
