struct Item =>
  value: int
  label: str
  values: int[]

  fn bump(): int =>
    self.value += 1
    self.values.push(self.value)
    return self.value + self.values.length

fn main(): void =>
  var original: Item = {
    value: 1,
    label: "old",
    values: {2}
  }
  var change = fn(a: Item as val): int => a.bump()
  println(change(original) == 4)
  println(change(original) == 4)
  println(original.value == 1 && original.values.length == 1)
