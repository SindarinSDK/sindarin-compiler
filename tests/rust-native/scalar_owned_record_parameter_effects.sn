struct Item =>
  value: int
  label: str
  values: int[]

fn appendValue(value: Outer as ref): int =>
  value.item.value += 1
  return value.item.value

struct Outer =>
  item: Item

fn main(): void =>
  var original: Outer = { item: Item {
    value: 1,
    label: "old",
    values: {2}
  } }
  var change = fn(a: Outer as val): int =>
    a.item.value = 9
    a.item.values.push(appendValue(a))
    return a.item.value + a.item.values.length
  println(change(original) == 12)
  println(original.item.value == 1 && original.item.values.length == 1)
