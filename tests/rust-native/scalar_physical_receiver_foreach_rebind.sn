struct Item =>
  value: int

  fn read(): int =>
    return self.value

fn main(): void =>
  var values: Item[] = { Item { value: 7 }, Item { value: 30 } }
  println(values[0].read() == 7)
  var sum: fn(Item[]): int = fn(a: Item[]): int =>
    var total: int = 0
    for item in a =>
      total += item.value
      a = { Item { value: 100 } }
    return total + a[0].value
  println(sum(values) == 137)
  println(values.length == 2 && values[0].value == 7 && values[1].value == 30)
