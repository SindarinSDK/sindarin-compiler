interface Named =>
  fn toString(): str

struct Empty =>
  fn toString(): str =>
    return "empty"

struct Value =>
  name: str

  fn toString(): str =>
    return self.name

struct Reference as ref =>
  name: str

  fn toString(): str =>
    return self.name

struct Holder =>
  value: Value

struct ReferenceHolder as ref =>
  item: Value

struct ArrayHolder =>
  values: Empty[]

struct Acceptor =>
  marker: int

  fn accept(value: Named): bool =>
    return true

fn accepts(value: Named): bool =>
  return true

fn same(left: Named, right: Named): bool =>
  return left == right

fn make(calls: int as ref): Value =>
  calls++
  return Value { name: "temporary" }

fn makeReference(calls: int as ref): Reference =>
  calls++
  return Reference { name: "returned" }

fn makeHolder(calls: int as ref): ReferenceHolder =>
  calls++
  return ReferenceHolder { item: Value { name: "temporary field" } }

fn main(): void =>
  var value: Value = { name: "value" }
  var reference: Reference = { name: "reference" }
  var alias = reference
  println(accepts(value))
  println(accepts(reference))
  println(same(value, value))
  println(same(reference, alias))
  var calls: int = 0
  var temporary = make(calls)
  println(accepts(temporary) && calls == 1)
  println(value.toString() == "value" && reference.toString() == "reference")
  var inspect: fn(): bool = fn(): bool => same(value, value) && same(reference, alias)
  println(inspect())
  var acceptor: Acceptor = { marker: 0 }
  println(acceptor.accept(value))
  var lambda: fn(Named): bool = fn(arg: Named): bool => true
  println(lambda(reference))
  var other: Value = { name: "value" }
  println(!same(value, other))
  var absent: Reference
  println(same(absent, absent) && !same(reference, absent))
  var holder: Holder = { value: Value { name: "held" } }
  println(same(holder.value, holder.value))
  var rows: Value[] = {value}
  println(same(rows[0], rows[0]))
  var fieldReader: fn(): bool = fn(): bool => same(holder.value, holder.value)
  println(fieldReader())
  println(!same(makeReference(calls), makeReference(calls)) && calls == 3)
  println(!same(makeHolder(calls).item, makeHolder(calls).item) && calls == 5)
  var empty1: Empty = {}
  var empty2: Empty = {}
  println(same(empty1, empty1) && !same(empty1, empty2))
  var empties: Empty[] = {empty1, empty2}
  println(same(empties[0], empties[1]))
  var copied = copyOf(empties)
  println(same(copied[0], copied[1]) && !same(copied[0], empties[0]))
  var slice = empties[0..2]
  println(same(slice[0], slice[1]) && !same(slice[0], empties[0]))
  var arrayHolder: ArrayHolder = { values: empties }
  println(same(arrayHolder.values[0], arrayHolder.values[1]))
  arrayHolder.values.push(Empty {})
  println(same(arrayHolder.values[0], arrayHolder.values[2]))
  var arrayFieldReader: fn(): bool = fn(): bool => same(arrayHolder.values[0], arrayHolder.values[2])
  println(arrayFieldReader())
