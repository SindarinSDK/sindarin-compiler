@source "native_callback_array_string_native_write.sn.c"

native fn mutate(values: str[]): str
native fn invoke(action: fn(str[]): bool, values: str[]): bool =>
  return action(values)

fn main(): void =>
  var values: str[] = {"a"}
  var action: fn(str[]): bool = fn(input: str[]): bool => input[0] == mutate(input)
  println(invoke(action, values))
  println(values[0] == "b")
