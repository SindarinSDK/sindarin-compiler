@source "scalar_double_integer_conversions.sn.c"

native fn double_integer_reference(value: double): int

fn nextValue(counter: int as ref): double =>
  counter += 1
  return - 1.75

fn verify(): bool =>
  var values: double[] = {0.0, -0.0, 0.999, -0.999, 1.75, -1.75, 42.5, -42.5, 9007199254740991.0, -9007199254740991.0, 9223372036854774784.0, -9223372036854775808.0}
  for value in values =>
    var integer: int = value.toInt()
    var longer: long = value.toLong()
    var reference: int = double_integer_reference(value)
    if integer != reference || longer.toInt() != reference =>
      return false
  return true

fn main(): void =>
  println(verify())
  var counter: int = 0
  var integer: int = nextValue(counter).toInt()
  var longer: long = nextValue(counter).toLong()
  println(counter == 2 && integer == -1 && longer == -1l)
