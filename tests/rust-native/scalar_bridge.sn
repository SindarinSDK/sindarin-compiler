@source "scalar_bridge.sn.c"

native fn c_int(value: int): int
native fn c_long(value: long): long
native fn c_int32(value: int32): int32
native fn c_uint(value: uint): uint
native fn c_uint32(value: uint32): uint32
native fn c_byte(value: byte): byte
native fn c_float(value: float): float
native fn c_double(value: double): double
native fn c_record(value: uint32): void
native fn c_recorded(): uint32

native fn c_body_add(left: int, right: int): int =>
  if left < 0 =>
    return right
  return left + right

fn main(): void =>
  assert(c_int(11) == 11)
  assert(c_long(12) == 12)
  assert(c_int32(13i32) == 13i32)
  assert(c_uint(14u) == 14u)
  assert(c_uint32(15u32) == 15u32)
  assert(c_byte(16b) == 16b)
  assert(c_float(17.5f) == 17.5f)
  assert(c_double(18.5) == 18.5)
  c_record(19u32)
  assert(c_recorded() == 19u32)
  assert(c_body_add(20, 22) == 42)
  println("rust native scalar bridge ok")
