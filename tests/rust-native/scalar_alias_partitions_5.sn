fn update(a: int[], b: int[], c: int[], d: int[], e: int[], depth: int): int =>
  if depth > 0 =>
    return update(a, b, c, d, e, depth - 1)
  a[0] += 1
  a.push(100)
  b[0] += 2
  b.push(101)
  c[0] += 4
  c.push(102)
  d[0] += 8
  d.push(103)
  e[0] += 16
  e.push(104)
  return a.length

