@source "nil-next-native-array.sn.c"

native fn absent(): byte[]
native fn empty(): byte[]

fn main(): void =>
  var missing: byte[] = absent()
  var allocated: byte[] = empty()
  println(missing == allocated)
  var missingCopy: byte[] = copyOf(missing)
  println(missingCopy == allocated)
  println(missing == missingCopy)
