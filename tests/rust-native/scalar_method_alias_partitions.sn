struct Ops =>
  marker: int

  fn update(a: int[], b: int[], c: int[], d: int[], depth: int): int =>
    if depth > 0 =>
      return self.update(a, b, c, d, depth - 1)
    a[0] += 1 * self.marker
    a.push(100)
    b[0] += 2 * self.marker
    b.push(101)
    c[0] += 4 * self.marker
    c.push(102)
    d[0] += 8 * self.marker
    d.push(103)
    return a.length

  static fn staticUpdate(a: int[], b: int[], c: int[], d: int[], depth: int): int =>
    if depth > 0 =>
      return Ops.staticUpdate(a, b, c, d, depth - 1)
    a[0] += 1
    a.push(100)
    b[0] += 2
    b.push(101)
    c[0] += 4
    c.push(102)
    d[0] += 8
    d.push(103)
    return a.length

