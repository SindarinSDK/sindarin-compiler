@source "../integration/test_serializable.sn.c"

native fn sn_test_json_encoder(): Encoder
native fn sn_test_json_decoder(input: str): Decoder

fn main(): void =>
  var encoder = sn_test_json_encoder()
  encoder.writeStr("name", "Ada")
  encoder.writeInt("age", 42)
  encoder.writeDouble("score", 3.5)
  encoder.writeBool("active", true)
  encoder.writeNull("missing")
  var first = encoder.result()
  println(first)
  println(encoder.result() == first)
  var decoder = sn_test_json_decoder(first)
  println(decoder.readStr("name"))
  println(decoder.readInt("age"))
  println(decoder.readDouble("score") == 3.5)
  println(decoder.readBool("active"))
  println(decoder.hasKey("missing"))
