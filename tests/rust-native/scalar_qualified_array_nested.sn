fn main(): void =>
  var values: int[][] = {{1, 2}, {3}}
  var change = fn(a: int[][] as val): int =>
    a[0][0] = 9
    a[0].push(4)
    a[1].clear()
    return a[0].length + a[1].length
  println(change(values) == 3)
  println(values[0][0] == 1 && values[0].length == 2 && values[1].length == 1)
  println(change(values) == 3)
