@source "builtin_exit_hooks.c"
native fn arm_exit_hooks(): int32
native fn c_exit_code(raw: str): int32

fn status(calls: int as ref, code: int): int =>
  calls++
  println(calls)
  return code

fn main(args: str[]): void =>
  assert(arm_exit_hooks() == 0, "stdio and atexit setup")
  var code: int = args[1].toInt()
  println(c_exit_code(args[1]))
  var calls: int = 0
  println("body")
  exit(status(calls, code))
  println("unreachable")
