struct Pair =>
  count: int
  marker: str

native fn invoke(action: fn(Pair): int, value: Pair as ref): int =>
  return action(value)

fn remember(value: Pair as ref): fn(): int =>
  return fn(): int => value.count + value.marker.length

fn forward(value: Pair as ref): fn(): int =>
  return remember(value)

fn build(): fn(): int =>
  var original: Pair = {
    count: 7,
    marker: "x"
  }
  return forward(original)

fn main(): void =>
  var read: fn(): int = build()
  println(read() == 8)
  var original: Pair = {
    count: 20,
    marker: "other"
  }
  var action: fn(Pair): int = fn(value: Pair): int => value.count
  println(invoke(action, original) == 20 && read() == 8)
