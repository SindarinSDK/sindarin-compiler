native fn invoke(action: fn(char[]): char[], values: char[]): char[] =>
  return action(values)

fn main(): void =>
  var values: char[] = {'a'}
  var action: fn(char[]): char[] = fn(input: char[]): char[] =>
    input.insert('b', 1)
    input.reverse()
    return input
  var result: char[] = invoke(action, values)
  var count: int = 0
  for value in result =>
    if value == 'a' || value == 'b' =>
      count = count + 1
  println(count == 2 && result.join("-") == "b-a")
  var popped: char = result.pop()
  result.remove(0)
  println(popped == 'a' && result.length == 0 && values.length == 2)
