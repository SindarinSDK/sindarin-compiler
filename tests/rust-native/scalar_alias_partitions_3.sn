fn update(a: int[], b: int[], c: int[], depth: int): int =>
  if depth > 0 =>
    return update(a, b, c, depth - 1)
  a[0] += 1
  a.push(100)
  b[0] += 2
  b.push(101)
  c[0] += 4
  c.push(102)
  return a.length

fn main(): void =>
  var forward: fn(int[], int[], int[]): int = fn(a: int[], b: int[], c: int[]): int =>
    return update(a, b, c, 2)
  var v0_0: int[] = {10}
  var result0: int = forward(v0_0, v0_0, v0_0)
  println(result0 == 4 && v0_0[0] == 17 && v0_0.length == 4 && v0_0[1] == 100 && v0_0[2] == 101 && v0_0[3] == 102)
  var v1_0: int[] = {10}
  var v1_1: int[] = {11}
  var result1: int = forward(v1_0, v1_0, v1_1)
  println(result1 == 3 && v1_0[0] == 13 && v1_0.length == 3 && v1_0[1] == 100 && v1_0[2] == 101 && v1_1[0] == 15 && v1_1.length == 2 && v1_1[1] == 102)
  var v2_0: int[] = {10}
  var v2_1: int[] = {11}
  var result2: int = forward(v2_0, v2_1, v2_0)
  println(result2 == 3 && v2_0[0] == 15 && v2_0.length == 3 && v2_0[1] == 100 && v2_0[2] == 102 && v2_1[0] == 13 && v2_1.length == 2 && v2_1[1] == 101)
  var v3_0: int[] = {10}
  var v3_1: int[] = {11}
  var result3: int = forward(v3_0, v3_1, v3_1)
  println(result3 == 2 && v3_0[0] == 11 && v3_0.length == 2 && v3_0[1] == 100 && v3_1[0] == 17 && v3_1.length == 3 && v3_1[1] == 101 && v3_1[2] == 102)
  var v4_0: int[] = {10}
  var v4_1: int[] = {11}
  var v4_2: int[] = {12}
  var result4: int = forward(v4_0, v4_1, v4_2)
  println(result4 == 2 && v4_0[0] == 11 && v4_0.length == 2 && v4_0[1] == 100 && v4_1[0] == 13 && v4_1.length == 2 && v4_1[1] == 101 && v4_2[0] == 16 && v4_2.length == 2 && v4_2[1] == 102)
