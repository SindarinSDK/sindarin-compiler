interface Named =>
  fn toString(): str

struct Item =>
  name: str
  fn toString(): str =>
    return self.name

struct Holder =>
  value: Item

fn same(a: Named, b: Named): bool =>
  return a == b

fn exercise(): bool =>
  var holder: Holder = { value: Item { name: "tracked" } }
  var items: Item[] = { Item { name: "one" }, Item { name: "two" } }
  for var j: int = 0; j < 8; j++ =>
    items.push(Item { name: "grown" })
  return same(holder.value, holder.value) && same(items[0], items[0])

fn main(): void =>
  var ok: bool = true
  for var i: int = 0; i < 1000; i++ =>
    ok = exercise() && ok
  println(ok)
