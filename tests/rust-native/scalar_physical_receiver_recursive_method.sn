struct Item =>
  value: int

  fn inner(a: Item[], depth: int): int =>
    if depth > 0 =>
      return self.inner(a, depth - 1)
    var before: int = self.value
    a.remove(0)
    self.value += 1
    return before * 100 + self.value

  fn outer(a: Item[]): int =>
    return self.inner(a, 2)

fn main(): void =>
  var call: fn(Item[], Item[]): int = fn(rows: Item[], a: Item[]): int =>
    return rows[0].outer(a)
  var values: Item[] = { Item { value: 7 } }
  println(call(values, values) == 708)
  println(values.length == 0)
