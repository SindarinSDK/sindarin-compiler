native fn invoke(action: fn(char[]): char[], values: char[]): char[] =>
  return action(values)

fn main(): void =>
  var values: char[] = {'a'}
  var action: fn(char[]): char[] = fn(input: char[]): char[] =>
    input[0] = 'c'
    input.push('b')
    return input
  var result: char[] = invoke(action, values)
  println(values.length == 2 && values[0] == 'c' && values[1] == 'b')
  println(result.length == 2 && result[0] == 'c' && result[1] == 'b')
