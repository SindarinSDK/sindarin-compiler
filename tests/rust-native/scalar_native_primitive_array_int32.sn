@source "scalar_native_primitive_array_int32.sn.c"
native fn change_array(a: int32[]): void
native fn same_array(a: int32[], b: int32[]): bool
fn main(): void =>
  var original: int32[] = {1i32}
  println(same_array(original, original))
  change_array(original)
  println(original.length == 2 && original[0] == 7i32 && original[1] == 9i32)
