interface Named =>
  fn toString(): str

struct Item =>
  name: str
  fn toString(): str =>
    return self.name

struct Holder =>
  value: Item

fn same(a: Named, b: Named): bool =>
  return a == b

fn address(value: Named): Named =>
  return value

fn main(): void =>
  var items: Item[] = { Item { name: "one" }, Item { name: "two" } }
  var original: Named = address(items[0])
  var reader: fn(): Named = fn(): Named => address(items[0])
  println(reader() == original)
  items[0].name = "changed"
  var textReader: fn(): str = fn(): str => items[0].name
  items[0].name = "after capture"
  println(textReader() == "after capture")
  println(reader() == address(items[0]))
  println(reader() == reader())
