fn main(): void =>
  var absent: double[] = nil
  var empty: double[] = {}
  var absentCopy: double[] = copyOf(absent)
  var emptyCopy: double[] = copyOf(empty)
  println(absent == absentCopy)
  println(absent == empty)
  println(empty == absent)
  println(empty == emptyCopy)
  println(absent != empty)
  println(absent == nil)
  println(empty == nil)
  var positive: double[] = {0.0}
  var negative: double[] = {-0.0}
  println(positive == negative)
  println(positive != negative)
  var bothAbsent: double[] = absent.concat(absentCopy)
  println(bothAbsent == nil)
  var joined: double[] = absent.concat(empty)
  println(joined == nil)
