fn main(): void =>
  var left: int[] = {1, 2}
  var right: int[] = {3, 4}
  var combined: int[] = left.concat(right)
  combined.push(5)
  println(left.length)
  println(right.length)
  println(combined.length)
  println(combined[0])
  println(combined[-1])

  var self_concat: int[] = left.concat(left)
  println(self_concat.length)
  println(self_concat[2])

  var empty: int[] = {}
  var with_empty: int[] = empty.concat(right)
  println(with_empty.length)

  var first_flags: bool[] = {true}
  var second_flags: bool[] = {false}
  var flags: bool[] = first_flags.concat(second_flags)
  println(flags[0])
  println(flags[1])
