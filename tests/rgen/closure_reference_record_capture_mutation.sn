struct State as ref =>
  value: int
  label: str

fn build(state: State): fn(): int =>
  return fn(): int =>
    state.value = state.value + 1
    return state.value

fn main(): void =>
  var state: State = {
    value: 10,
    label: "alive"
  }
  var action: fn(): int = build(state)
  var first: int = action()
  var second: int = action()
  println($"{first} {second} {state.value} {state.label}")
