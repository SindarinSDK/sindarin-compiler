fn main(): void =>
  var text: str = "ab"
  var appended: str = text.append("é")
  var bytes: byte[] = appended.toBytes()
  print($"append=<{appended}>/{appended.length}\n")
  print($"bytes={bytes.length}/{bytes[0]}/{bytes[1]}/{bytes[2]}/{bytes[3]}\n")
  print($"ints={"  -42tail".toInt()}/{"9223372036854775808".toLong()}\n")
  print($"doubles={"  -3.5tail".toDouble()}/{"1e2".toDouble()}\n")
