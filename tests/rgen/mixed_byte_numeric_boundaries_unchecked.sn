fn markByte(trace: int as ref, marker: int, value: byte): byte =>
  trace = trace * 10 + marker
  return value

fn markInt(trace: int as ref, marker: int, value: int): int =>
  trace = trace * 10 + marker
  return value

fn main(): void =>
  var trace: int = 0
  var mixed: int = markByte(trace, 1, 255) + markInt(trace, 2, 1000)
  println(mixed)
  println(trace)

  trace = 0
  var stored: int = markByte(trace, 1, 200) * markByte(trace, 2, 200)
  println(stored)
  println(trace)

  var total: int = 0
  var value: byte = 255
  total = total + value
  println(total)
