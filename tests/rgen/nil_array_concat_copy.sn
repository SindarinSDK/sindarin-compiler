fn main(): void =>
  var absent: int[] = nil
  var empty: int[] = {}
  var values: int[] = {4, 5}
  var bothAbsent: int[] = absent.concat(absent)
  println(bothAbsent == nil)
  var leftAbsent: int[] = absent.concat(empty)
  println(leftAbsent == nil)
  var rightAbsent: int[] = empty.concat(absent)
  println(rightAbsent == nil)
  var joined: int[] = absent.concat(values)
  joined[0] = 9
  println(values[0])
  println(joined[0])
  println(absent)
  println(empty)
  var nested: int[][] = {{1, 2}, {}}
  nested[1] = nil
  var copied: int[][] = copyOf(nested)
  copied[0][0] = 8
  println(nested[0][0])
  println(copied[0][0])
  println(copied[1] == nil)
  copied[1] = {}
  println(nested[1] == nil)
  println(copied[1] == nil)
