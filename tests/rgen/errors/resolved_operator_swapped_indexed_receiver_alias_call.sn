struct Item =>
  value: int

  operator < (other: Item as ref): bool =>
    other.value = other.value + 1
    return self.value < other.value

fn makeFrom(item: Item): Item =>
  return Item { value: item.value + 1 }

fn main(): void =>
  var items: Item[] = {}
  items.push(Item { value: 1 })
  println(items[0] > makeFrom(items[0]))
