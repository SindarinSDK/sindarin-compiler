fn main(): void =>
  var left: int[][] = {{1, 2}}
  var right: int[][] = {{3, 4}}
  var combined: int[][] = left.concat(right)
  left[0] = {9}
  right[0] = {8}
  println($"{combined.length} {combined[0][0]} {combined[0][1]} {combined[1][0]} {combined[1][1]}")
  println($"{left[0][0]} {right[0][0]}")
