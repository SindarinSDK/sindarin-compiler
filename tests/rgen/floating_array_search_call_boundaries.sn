fn storedWide(): double =>
  return 16777217.0f

fn asFloat(value: float, calls: int as ref): float =>
  calls++
  return value

fn asDouble(value: double, calls: int as ref): double =>
  calls++
  return value

fn appendNeedle(values: float[], calls: int as ref): float =>
  calls++
  values.push(1.5f)
  return 1.5f

fn main(): void =>
  var calls: int = 0
  var values: float[] = {0.0f, 16777216.0f}
  var wide: double[] = {16777217.0}
  println(values.indexOf(asFloat(16777217.0f, calls)))
  println(calls)
  println(wide.indexOf(asDouble(16777217.0f, calls)))
  println(calls)
  println(wide.indexOf(16777217.0f))
  println(wide.indexOf(-16777217.0f))
  var empty: double[] = {}
  println(empty.contains(asFloat(16777217.0f, calls)))
  println(calls)
  println(empty.indexOf(asFloat(16777217.0f, calls)))
  println(calls)
  var callback: fn(double): double = fn(value: double): double => value
  println(wide.indexOf(callback(16777217.0f)))
  println(wide.indexOf(storedWide()))
  var mutableValues: float[] = {0.0f}
  println(mutableValues.contains(appendNeedle(mutableValues, calls)))
  println(calls)
  println(mutableValues.length)
  println(mutableValues[1] == 0.0f)
