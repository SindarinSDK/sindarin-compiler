struct Holder =>
  values: int[][][]

fn main(): void =>
  var holder: Holder = { values: {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}} }
  var copied: int[][][] = holder.values.clone()
  var __sn_place_raw_index_0: int = 0
  var __sn_nullable_store_value_0: int = 91
  holder.values[__sn_place_raw_index_0][-1][-1] = __sn_nullable_store_value_0
  copied[-1][-1][-1] = 99
  println($"{holder.values[0][1][1]} {holder.values[1][1][1]}")
  println($"{copied[0][1][1]} {copied[1][1][1]}")
