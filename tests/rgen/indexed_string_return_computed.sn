fn source(calls: int as ref): str[] =>
  calls += 1
  return {"alpha", "beta"}

fn index(calls: int as ref): int =>
  calls += 1
  return - 1

fn select(calls: int as ref): str =>
  return source(calls)[index(calls)]

fn main(): void =>
  var calls: int = 0
  var result: str = select(calls)
  println(result)
  println(calls)
