fn rhs(values: int[], calls: int as ref): int =>
  calls++
  values[1] = 9
  values.push(0)
  return 3

fn growingIndex(values: int[], calls: int as ref): int =>
  calls++
  values.push(0)
  return - 1

fn main(): void =>
  var calls: int = 0
  var values: int[] = {2, 4}
  println(values[0] += rhs(values, calls))
  println(values[0])
  println(values[1])
  println(values.length)
  println(calls)
  var growing: int[] = {0}
  calls = 0
  growing[growingIndex(growing, calls)] += 0
  println(growing.length)
  println(calls)
  println(growing[0] == 0 && growing[1] == 0 && growing[2] == 0)
  calls = 0
  println(growing[growingIndex(growing, calls)]++)
  println(growing.length)
  println(calls)
  println(growing[-1])
