struct Item =>
  value: int
  operator < (other: Item as ref): bool =>
    other.value = other.value + 1
    return self.value < other.value

fn makeFrom(item: Item): Item => return Item { value: item.value + 1 }
fn index(calls: int as ref): int =>
  calls++
  return 0

fn main(): void =>
  var items: Item[] = { Item { value: 1 } }
  var calls: int = 0
  println(items[index(calls)] > makeFrom(items[0]))
  println(calls)
  println(items[0].value)
