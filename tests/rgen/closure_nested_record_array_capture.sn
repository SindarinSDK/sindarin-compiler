struct Child =>
  count: int
  values: int[]

struct Subject =>
  child: Child
  label: str

fn touch(value: Subject): int =>
  value.child.count = value.child.count + 1
  value.child.values[0] = value.child.values[0] + 1
  println($"inside {value.child.count} {value.label} {value.child.values[0]}")
  return value.child.count

fn make(): fn(): int =>
  var subject: Subject = {
    child: Child {
      count: 10,
      values: {100}
    },
    label: "before"
  }
  return fn(): int => touch(subject)

fn main(): void =>
  var action: fn(): int = make()
  var first: int = action()
  var second: int = action()
  println($"{first} {second}")
