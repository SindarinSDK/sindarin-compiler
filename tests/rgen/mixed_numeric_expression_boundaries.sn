fn nextInt(calls: int as ref): int =>
  calls++
  return 5

fn nextDouble(calls: int as ref): double =>
  calls++
  return 2.5

fn main(): void =>
  var calls: int = 0
  var sum: double = nextInt(calls) + nextDouble(calls)
  println(sum)
  println(calls)

  var comparison: bool = nextInt(calls) > nextDouble(calls)
  println(comparison)
  println(calls)
  println(5 <= 5.5)
  println(5 >= 5.5)
  println(5 != 5.5)
  println(5 % 2.5)

  var widened: double = nextInt(calls)
  println(widened)
  println(calls)
