struct ByteIterator =>
  value: byte
  remaining: int

  fn iter(): ByteIterator =>
    return self

  fn hasNext(): bool =>
    return self.remaining > 0

  fn next(): byte =>
    self.remaining -= 1
    return self.value

fn main(): void =>
  var source: ByteIterator = {
    value: 255b,
    remaining: 1
  }
  for value in source =>
    var previous: byte = value++
    previous++
