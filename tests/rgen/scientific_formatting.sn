fn main(): void =>
  var large: double = 1234.5
  var small: double = 0.00125
  var negative: double = -42.0
  var zero: double = 0.0
  var rounded: double = 9.999
  var single: float = 12.5f
  var divisor: double = 0.0
  var infinity: double = 1.0 / divisor
  var negative_infinity: double = -1.0 / divisor

  println($"default={large:e}")
  println($"precision={small:.2e}")
  println($"uppercase={negative:.1E}")
  println($"zero={zero:.3e}")
  println($"rounded={rounded:.2e}")
  println($"float={single:.3E}")
  println($"width=|{large:14.2e}|")
  println($"left=|{large:-14.2e}|")
  println($"sign=|{large:+.2e}|")
  println($"zero=|{large:014.2e}|")
  println($"positive-zero=|{large:+014.2e}|")
  println($"negative-zero=|{negative:014.1e}|")
  println($"combined=|{large:-+014.2E}|")
  println($"infinity=|{infinity:+010.2e}|")
  println($"negative-infinity=|{negative_infinity:-010.2E}|")
