fn main(): void =>
  var mixed: int[] = {0, 1..4, 10}
  println(mixed.length)
  println(mixed[0])
  println(mixed[1])
  println(mixed[-2])
  println(mixed[-1])

  var source: int[] = {1, 2, 3}
  var spread: int[] = {0, ...source, 4}
  source[0] = 9
  println(spread.length)
  println(spread[1])

  var left: int[] = {5, 6}
  var right: int[] = {7, 8}
  var combined: int[] = {...left, ...right}
  println(combined.length)
  println(combined[0])
  println(combined[-1])

  var empty: int[] = {}
  var with_empty: int[] = {-1, ...empty, 2..4}
  println(with_empty.length)
  println(with_empty[-1])

  var names: str[] = {"alpha", "beta"}
  var copied_names: str[] = {...names, "gamma"}
  names[0] = "changed"
  println(copied_names.join(","))
