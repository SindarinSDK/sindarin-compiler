fn observe(calls: int as ref, value: char): char =>
  calls += 1
  return value

fn main(): void =>
  var calls: int = 0
  var selected: int = match observe(calls, '\xff') =>
    'a' => 0
    '\xff' => 42
    else => -1
  var result: char = match '\xff' =>
    '\xff' => 'z'
    else => 'x'
  println(selected)
  println(calls)
  println(result)
