struct IntIterator =>
  remaining: int

  fn iter(): IntIterator =>
    return self

  fn hasNext(): bool =>
    return self.remaining > 0

  fn next(): int =>
    self.remaining -= 1
    return 4

fn mutate(parameter: int): void =>
  var source: IntIterator = { remaining: 1 }
  for value in source =>
    value += 1
    parameter += 1

fn main(): void =>
  mutate(1)
