struct FloatIterator =>
  remaining: int

  fn iter(): FloatIterator =>
    return self

  fn hasNext(): bool =>
    return self.remaining > 0

  fn next(): float =>
    self.remaining -= 1
    return 5.0f

fn main(): void =>
  var source: FloatIterator = { remaining: 1 }
  for value in source =>
    value += 2.0
