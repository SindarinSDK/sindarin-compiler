fn observeSize(calls: int as ref, size: int): int =>
  calls++
  print($"S{calls} ")
  return size

fn observeInt(calls: int as ref): int =>
  calls++
  print($"I{calls} ")
  return calls * 10

fn main(): void =>
  var size_calls: int = 0
  var int_calls: int = 0
  var values: int[observeSize(size_calls, 2)] = observeInt(int_calls)
  var strings: str[2] = "value"
  println($"|{size_calls},{int_calls},{values[0]},{values[1]},{strings[0]},{strings[1]}")

  var zero_size_calls: int = 0
  var zero_default_calls: int = 0
  var empty: int[observeSize(zero_size_calls, 0)] = observeInt(zero_default_calls)
  println($"|{zero_size_calls},{zero_default_calls},{empty.length}")

  var seed: str = "seed"
  var copies: str[2] = seed
  seed = "changed"
  println($"|{copies[0]},{copies[1]},{seed}")

  var __sn_sized_array: int = 2
  var __sn_sized_index: int = 7
  var __sn_sized_array_0: int = 3
  var __sn_sized_index_0: int = 8
  var first: int[__sn_sized_array] = __sn_sized_index
  var second: int[__sn_sized_array_0] = __sn_sized_index_0
  println($"|{first[0]},{first[1]},{second[0]},{second[2]}")
