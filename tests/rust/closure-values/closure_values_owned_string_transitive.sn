fn make(seed: str): fn(): fn(str): str =>
  var value: str = seed
  return fn(): fn(str): str =>
    value += "-middle"
    return fn(suffix: str): str =>
      value += suffix
      return value

fn makeDirect(seed: str): fn(str): str =>
  return fn(suffix: str): str =>
    seed += suffix
    return seed

fn main(): void =>
  var factory: fn(): fn(str): str = make("root")
  var first: fn(str): str = factory()
  var second: fn(str): str = factory()
  println(first("-one"))
  println(first("-two"))
  println(second("-three"))
  var other: fn(): fn(str): str = make("other")
  var third: fn(str): str = other()
  println(third("-four"))
  var direct: fn(str): str = makeDirect("param")
  println(direct("-one"))
  println(direct("-two"))
